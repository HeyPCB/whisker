  "netClasses": [
    {
      "name": "BATTERY",
      "nets": [
        "BAT_RAW"
      ],
      "track": 2.0,
      "clearance": 0.2,
      "via": [
        1.2,
        0.7
      ],
      "currentA": 5.0,
      "why": "the pack to the reverse-polarity FET: all of the board's current, 5 A at the pack's limit (spec 1.3). The FET's drain pad sits 0.7 mm below the battery pin, so 2.0 mm reaches it on F.Cu; the current budget keeps the ladder from narrowing it. At 1.0 mm the router put 10.9 mm of it on In1 behind one 0.4 mm via, about 1.2 A at a 10 C rise on 1 oz inner copper (2026-10-02)"
    },
    {
      "name": "SERVO",
      "nets": [
        "VBAT"
      ],
      "track": 1.0,
      "clearance": 0.2,
      "via": [
        0.8,
        0.4
      ],
      "currentA": 2.4,
      "why": "the 2S pack to 11 servos, pack-limited to 5 A (spec 3.2); currentA 2.4 is what 1.0 mm of 1 oz outer copper carries at a 10 C rise (route.ipc2221_amps), and it keeps the ladder from narrowing the rail (it went to 0.2 mm once, 2026-10-02); the In2 VBAT pour carries the rest. 1.0 mm still enters the AON6411's 1.27 mm-pitch source pins and the 0402 divider clear of their neighbours; VBAT is also poured on In2 after routing (board.pours)"
    },
    {
      "name": "BUCK",
      "nets": [
        "VBUCK",
        "BUCK_SW"
      ],
      "track": 0.6,
      "clearance": 0.2,
      "via": [
        0.8,
        0.4
      ],
      "why": "the buck's input (about 2.3 A at 3 A out from 7.4 V) and switch node, both a few mm long. VIN and SW leave adjacent pins 0.95 mm apart: at 0.8 mm SW stayed open at U5 (2026-10-02); 0.6 mm leaves room to fan out"
    },
    {
      "name": "PWR5",
      "nets": [
        "5V",
        "VBUS",
        "VBUS_F"
      ],
      "track": 0.5,
      "clearance": 0.2,
      "via": [
        0.6,
        0.3
      ],
      "why": "the 5 V logic rail (MCU, Grove, dongle, Pi) and the USB feed; 0.5 mm is the widest that enters the TQFP-32's 0.8 mm-pitch VCC pins and the LM66100's SC-70 pins at 0.2 mm"
    },
    {
      "name": "PWR3",
      "nets": [
        "3V3"
      ],
      "track": 0.25,
      "clearance": 0.15,
      "via": [
        0.6,
        0.3
      ],
      "why": "tens of mA; 0.25 mm enters the MPU-6050's 0.5 mm-pitch QFN pins, and 0.15 mm is the PCA9306 land's own pad gap (a 0.2 mm class clearance put DRC rows on U7's pads 1-3, 2026-10-02)"
    }
  ],
